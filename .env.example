# Copia este archivo a .env y ajusta la URL de library_api (semana 9: configuración por ambientes).
# Expo expone al bundle SOLO las variables con prefijo EXPO_PUBLIC_ → nunca pongas secretos aquí.
#
# - Producción (Vercel): https://guia-1-library.vercel.app
# - Dispositivo físico (Expo Go): IP local de tu PC en la misma red Wi-Fi, ej. http://192.168.1.20:3000
# - Emulador Android: http://10.0.2.2:3000
# - Simulador iOS: http://localhost:3000
EXPO_PUBLIC_API_URL=https://guia-1-library.vercel.app
